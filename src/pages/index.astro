---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <div class="about">
    <h1>{site.name}</h1>
    <p class="bio">{site.bio}</p>
  </div>
</BaseLayout>

<style>
  .about {
    min-height: calc(100vh - 68px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    padding: clamp(64px, 16vh, 170px) clamp(24px, 6vw, 40px) 96px;
  }

  h1 {
    margin: 14px 0 0;
    font-size: clamp(9.6px, 1.92vw, 22.2px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
    white-space: nowrap;
  }

  .bio {
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 66ch;
    margin-top: 18px;
  }
</style>
