---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, url } from '../data/site';

// Drop your résumé at public/resume.pdf — Astro copies public/ to the site
// root, so it is served at <base>/resume.pdf.
const pdf = url('/resume.pdf');
---

<BaseLayout title="Resume" description={`${site.name}'s résumé.`}>
  <div class="page">
    <div class="bar">
      <h1>Resume</h1>
      <a class="download" href={pdf} download>Download PDF</a>
    </div>
    <object class="viewer" data={pdf} type="application/pdf" title={`${site.name}'s résumé`}>
      <div class="fallback">
        <p>The résumé can't be displayed inline here.</p>
        <a href={pdf} download>Download the résumé</a>
      </div>
    </object>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 8.5in;
    margin: 0 auto;
    padding: clamp(28px, 5vh, 56px) clamp(16px, 4vw, 48px) 90px;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 18px;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 14px;
  }

  h1 {
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .download {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--bg);
    padding: 9px 15px;
    white-space: nowrap;
  }

  .viewer {
    display: block;
    width: 100%;
    aspect-ratio: 8.5 / 11;
    margin-top: 22px;
    border: 1px solid var(--rule);
    background: var(--faint);
  }

  /* Shown when the browser won't render the PDF inline (iOS Safari), or when
     public/resume.pdf is missing. */
  .fallback {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-align: center;
    padding: 24px;
  }

  .fallback p {
    font-size: 13.5px;
    color: var(--muted);
  }

  .fallback a {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 3px;
  }

  /* An embedded PDF can't print from the host page — print the heading and the
     link to it rather than an empty box. */
  @media print {
    .viewer {
      display: none;
    }
  }
</style>
